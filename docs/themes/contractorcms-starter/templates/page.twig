{{ widgets.header }}
<div class="contractorcms-starter">
  <div class="starter-intro starter-tone-{{ settings.tone }}">
    <div class="starter-container">
      {% if settings.show_tagline %}
        <p class="starter-eyebrow">{{ settings.tagline }}</p>
      {% endif %}
      <h1>{{ page.title }}</h1>
      {% if page.excerpt %}
        <p class="starter-excerpt">{{ page.excerpt }}</p>
      {% endif %}
    </div>
  </div>
  <div class="starter-container starter-content">
    {{ page.content }}
  </div>
  {{ widgets.contact }}
</div>
{{ widgets.footer }}
