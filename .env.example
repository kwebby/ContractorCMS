# Author: ramanpal singh
# URL: https://kwebby.com

APP_NAME=ContractorCMS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://cms.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=contractor_cms
DB_USERNAME=contractor_cms
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

DATA_PROVIDER=postgres
CMS_MFA_REQUIRED=true

SESSION_SECURE_COOKIE=true
DB_SSLMODE=prefer
# Supabase: DATA_PROVIDER=supabase, DB_CONNECTION=pgsql, DB_SSLMODE=require.
FIRESTORE_EXPERIMENTAL=false
FIRESTORE_PROJECT_ID=
FIRESTORE_DATABASE=(default)
GOOGLE_APPLICATION_CREDENTIALS=
FIRESTORE_EMULATOR_HOST=

# Comma-separated trusted proxy IPs/CIDRs only when a reverse proxy is configured.
TRUSTED_PROXIES=
